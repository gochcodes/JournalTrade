        SELECT
            COUNT(*) as total_trades,
            COALESCE(SUM(profit_loss), 0) as total_pl,
            COALESCE(SUM(CASE WHEN profit_loss > 0 THEN 1 ELSE 0 END), 0) as winning_trades,
